### Maven / build output ###
target/
build/
dist/

# Compiled class files
*.class

# Build artifacts / archives
# (guard the Maven wrapper jar so `*.jar` never nukes it)
*.jar
!.mvn/wrapper/maven-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

### Logs ###
*.log

# JVM crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

### IDEs / editors ###
# IntelliJ per-user files are handled by .idea/.gitignore; shared project
# config under .idea/ is committed intentionally.
# Eclipse
.classpath
.project
.settings/
# VS Code
.vscode/
# NetBeans
nbproject/private/
nbbuild/
nbdist/

